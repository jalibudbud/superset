# Superset Modular Deployment Configuration
# Configure only what you need for your deployment

# ===== REQUIRED: Superset Image =====
SUPERSET_IMAGE=yourcompany/superset:latest

# ===== REQUIRED: Security =====
# Generate using: openssl rand -base64 42
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY

# ===== Superset Configuration =====
SUPERSET_PORT=8088
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no

# ===== DATABASE CONFIGURATION =====
# Choose ONE option:

# OPTION 1: Use bundled PostgreSQL (default)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql
DATABASE_USER=superset
DATABASE_PASSWORD=change_this_postgres_password
DATABASE_DB=superset
# PostgreSQL exposed port (if you want external access)
POSTGRES_PORT=5432

# OPTION 2: Use external PostgreSQL
# DATABASE_HOST=your-postgres-server.example.com
# DATABASE_PORT=5432
# DATABASE_DIALECT=postgresql
# DATABASE_USER=superset_user
# DATABASE_PASSWORD=your_external_db_password
# DATABASE_DB=superset_production

# OPTION 3: Use MySQL
# DATABASE_HOST=your-mysql-server.example.com
# DATABASE_PORT=3306
# DATABASE_DIALECT=mysql
# DATABASE_USER=superset_user
# DATABASE_PASSWORD=your_mysql_password
# DATABASE_DB=superset_production

# ===== REDIS CONFIGURATION (Optional) =====
# Only needed if using async queries or caching

# OPTION 1: Use bundled Redis (default)
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
# Redis exposed port (if you want external access)
REDIS_PORT=6379

# OPTION 2: Use external Redis
# REDIS_HOST=your-redis-server.example.com
# REDIS_PORT_INTERNAL=6379

# OPTION 3: No Redis (sync queries only, no caching)
# Leave empty or comment out
# REDIS_HOST=
# REDIS_PORT_INTERNAL=

# ===== CELERY WORKERS (Optional) =====
# Only needed for async queries and scheduled tasks
CELERY_WORKERS=4

# ===== DEPLOYMENT PROFILE =====
# Uncomment ONE profile to use:

# Profile 1: Minimal - Only Superset (use external DB/Redis)
# COMPOSE_PROFILES=

# Profile 2: Superset + Database only
# COMPOSE_PROFILES=database

# Profile 3: Superset + Redis only (for caching with external DB)
# COMPOSE_PROFILES=cache

# Profile 4: Superset + Workers (use external DB/Redis)
# COMPOSE_PROFILES=workers

# Profile 5: Full stack (everything included)
COMPOSE_PROFILES=full